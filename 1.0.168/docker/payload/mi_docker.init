#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
EXTRA_COMMANDS="start_from_disk start_docker stop_docker ui_install ui_uninstall install_portainer"
start_service() {
    [ "$(uci -q get mi_docker.settings.docker_enable)" = 1 ] || return 0
    [ "$(uci -q get mi_docker.settings.docker_install)" = 1 ] || return 0
    procd_open_instance managed168
    procd_set_param command /bin/sh /data/router-docker-1.0.168/runtime/launch.sh
    procd_set_param respawn 3600 10 2
    procd_set_param term_timeout 60
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
stop_service() { :; }
start_from_disk() { start; }
start_docker() { start; }
stop_docker() { stop; }
ui_install() { sh /data/router-docker-1.0.168/runtime/control.sh install; }
ui_uninstall() { sh /data/router-docker-1.0.168/runtime/control.sh uninstall; }
install_portainer() { sh /data/router-docker-1.0.168/runtime/control.sh portainer; }
