# Local build tools, downloads, configuration and caches
/.tools/
/local/
/rom/
.env
.env.*
**/__pycache__/
**/.pytest_cache/
**/.test-cache/
*.log
*.tmp
*.bak
*.key
*.pem
*_host_key
authorized_keys
known_hosts*

# Distribution packages under dist/ are committed with source.
!/dist/
!/dist/**

# Tests remain local. Markdown documentation is allowed.
**/tests/**
**/__tests__/**
!**/tests/**/
!**/__tests__/**/
!**/tests/**/*.md
!**/__tests__/**/*.md
test_*.py
test_*.sh
test_*.lua
*_test.py
*_test.sh
*.test.*
*.spec.*
!*.md
